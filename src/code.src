### class Node {
    var void data;
    var void next;

    func void constructor(void data) {
        this.data = data;
        this.next = null;
    }
}

class LinkedList {
    var void head;

    func LinkedList constructor() {
        this.head = null;
    }

    func void prepend(void data) {
        var Node newNode = Node(data);
        newNode.next = this.head;
        this.head = newNode;
    }

    func void printList() {
        var void current = this.head;
        while (current != null) {
            print(current.data);
            current = current.next;
        }
    }
}

var LinkedList list = LinkedList();
list.prepend(30);
list.prepend(20);
list.prepend(10);

list.printList();
