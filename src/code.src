###
Repräsentiert einen einzelnen Knoten in der Liste.
Hält den Wert und den Verweis auf den Nachfolger.
###

class Vector {
    var int x;
    var int y;

    func Vector constructor(int px, int py) {
        x = px;
        y = py;
    }

    func Vector __add__(Vector other) {
        return Vector(x + other.x, y + other.y);
    }
}

# Verwendung:
var Vector v1 = Vector(10, 5);
var Vector v2 = Vector(2, 3);
// obj.this not working
var Vector v3 = v1 + v2;

print(v3.x); # Ausgabe: 12
print(v3.y); # Ausgabe: 8